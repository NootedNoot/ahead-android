<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Debug Menu"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ===================== Glucose injection ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="GLUCOSE INJECTION — MANUAL OVERRIDE" />

        <TextView style="@style/DebugLabel" android:text="Value (mg/dL)" />
        <EditText
            android:id="@+id/manualValueInput"
            style="@style/TuningInput"
            android:hint="e.g. 120"
            android:inputType="number" />

        <TextView style="@style/DebugLabel" android:text="Rate of change (mg/dL/min, signed)" />
        <EditText
            android:id="@+id/manualRateInput"
            style="@style/TuningInput"
            android:hint="e.g. -1.5"
            android:inputType="numberDecimal|numberSigned" />

        <TextView style="@style/DebugLabel" android:text="Age override (min) — 0 = fresh, large = force stale" />
        <EditText
            android:id="@+id/manualAgeInput"
            style="@style/TuningInput"
            android:hint="0"
            android:inputType="number" />

        <Button android:id="@+id/injectManualButton" style="@style/DebugButton" android:text="Inject now" />
        <Button android:id="@+id/forceStaleButton" style="@style/DebugButton" android:text="Force stale now (uses value above)" />

        <TextView style="@style/DebugSectionHeader" android:text="GLUCOSE INJECTION — PRESET SCENARIOS" />

        <TextView style="@style/DebugLabel" android:text="Scenario" />
        <Spinner
            android:id="@+id/scenarioSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView style="@style/DebugLabel" android:text="Playback speed" />
        <RadioGroup
            android:id="@+id/speedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/speed1x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x (real time)"
                android:textColor="@color/text_primary"
                android:checked="true" />

            <RadioButton
                android:id="@+id/speed10x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="10x"
                android:textColor="@color/text_primary" />

        </RadioGroup>

        <Button android:id="@+id/playScenarioButton" style="@style/DebugButton" android:text="Play scenario" />
        <Button android:id="@+id/stopScenarioButton" style="@style/DebugButton" android:text="Stop playback" />

        <TextView
            android:id="@+id/scenarioProgressText"
            style="@style/DebugStatusText"
            android:text="" />

        <TextView style="@style/DebugSectionHeader" android:text="GLUCOSE INJECTION — STRESS TEST" />

        <TextView style="@style/DebugLabel" android:text="Number of random points (spread over 6 hours)" />
        <EditText
            android:id="@+id/randomCountInput"
            style="@style/TuningInput"
            android:hint="e.g. 150"
            android:inputType="number" />

        <Button android:id="@+id/injectRandomButton" style="@style/DebugButton" android:text="Inject N random points" />
        <Button android:id="@+id/clearInjectionButton" style="@style/DebugButton" android:text="Clear injected data (use real Health Connect)" />

        <!-- ===================== Report export stress test ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="DOCTOR REPORT — STRESS TEST" />

        <TextView
            style="@style/DebugStatusText"
            android:text="Injects a synthetic 14-day series ending now, with a deliberate 6-day gap in the middle (no readings at all) and values that sweep every severity zone - exercises full-range pagination, gap rendering, and color coding without depending on real device data." />

        <Button android:id="@+id/injectReportTestDataButton" style="@style/DebugButton" android:text="Inject 14-day range w/ gap (report test)" />
        <Button android:id="@+id/openDoctorReportButton" style="@style/DebugButton" android:text="Open Doctor Report" />

        <!-- ===================== Notes history stress test ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="NOTES — BACKDATED EVENT TEST" />

        <TextView
            style="@style/DebugStatusText"
            android:text="Logs a real UserEvent with a timestamp set N hours in the past - for testing that the notes history screen's edit/delete works on entries GraphActivity's own 6h chart window would never surface." />

        <TextView style="@style/DebugLabel" android:text="Tag" />
        <Spinner
            android:id="@+id/debugEventTagSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView style="@style/DebugLabel" android:text="Note" />
        <EditText
            android:id="@+id/debugEventNoteInput"
            style="@style/TuningInput"
            android:hint="e.g. Backdated test note" />

        <TextView style="@style/DebugLabel" android:text="Hours ago" />
        <EditText
            android:id="@+id/debugEventHoursAgoInput"
            style="@style/TuningInput"
            android:hint="e.g. 10"
            android:inputType="number" />

        <Button android:id="@+id/injectBackdatedEventButton" style="@style/DebugButton" android:text="Inject backdated event" />
        <Button android:id="@+id/openNotesHistoryButton" style="@style/DebugButton" android:text="Open Notes History" />

        <!-- ===================== Plateau stress test ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="PLATEAU — STRESS TEST" />

        <TextView
            style="@style/DebugStatusText"
            android:text="Seeds a flat ~320 mg/dL series covering the full plateau lookback window, then queues a real GlucoseCheckWorker cycle - collapses the 90-minute default wait into one tap. Lower PLATEAU_COOLDOWN/HIGH_DURATION in Tuning Parameters first to see escalation/re-fire quickly." />

        <Button android:id="@+id/injectPlateauScenarioButton" style="@style/DebugButton" android:text="Inject sustained-high plateau + Check now" />

        <TextView
            style="@style/DebugStatusText"
            android:text="Simulates tapping the real 'Correction' preset tag (same PlateauCoordinator.onCorrectionLogged hook), without going through the tag-picker dialog. Tap twice quickly to also test the repeat-correction-logged notification." />

        <Button android:id="@+id/simulateLogCorrectionButton" style="@style/DebugButton" android:text="Simulate: log correction now" />

        <!-- ===================== Notification testing ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="NOTIFICATION TESTING" />

        <Button android:id="@+id/forceYellowButton" style="@style/DebugButton" android:text="Force-trigger YELLOW alert" />
        <Button android:id="@+id/forceRedButton" style="@style/DebugButton" android:text="Force-trigger RED (critical) alert" />
        <Button android:id="@+id/forceSignalLostButton" style="@style/DebugButton" android:text="Force-trigger signal-lost alert" />
        <Button android:id="@+id/cancelAlertsButton" style="@style/DebugButton" android:text="Cancel all alerts" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Voice alerts (master)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Switch android:id="@+id/voiceMasterSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send app to background after forcing an alert"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Switch android:id="@+id/autoBackgroundSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ===================== Chart / UI testing ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="CHART / UI TESTING" />

        <TextView
            style="@style/DebugStatusText"
            android:text="Injected data (manual/preset/random above) feeds the real chart data source, so the Graph screen's own 1hr/3hr/6hr and Tight/Full/Auto toggles already exercise every combination against it - open it below and cycle through them for a screenshot pass." />

        <Button android:id="@+id/openGraphButton" style="@style/DebugButton" android:text="Open glucose graph" />

        <!-- ===================== System state ===================== -->

        <TextView style="@style/DebugSectionHeader" android:text="SYSTEM STATE" />

        <TextView android:id="@+id/batteryStatusText" style="@style/DebugStatusText" android:text="Battery optimization: —" />
        <TextView android:id="@+id/hcPermsStatusText" style="@style/DebugStatusText" android:text="Health Connect permissions: —" />
        <TextView android:id="@+id/dndStatusText" style="@style/DebugStatusText" android:text="DND policy access: —" />
        <TextView android:id="@+id/injectionStatusText" style="@style/DebugStatusText" android:text="Chart data source: —" />

        <Button android:id="@+id/refreshStatusButton" style="@style/DebugButton" android:text="Refresh status" />

        <Button android:id="@+id/closeButton" style="@style/DebugButton" android:text="Close" android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
