<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===================== Persistent Top Header ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Debug &amp; Diagnostics"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/debug_badge_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEBUG BUILD"
                android:textColor="@color/accent2"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ===================== Scrollable Body ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developer controls, clinical demo playback, and system diagnostics."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <!-- ===================== SECTION 1: SERVER & TUNNEL ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="🌐 SERVER &amp; SYNC ($0/mo)" />

            <LinearLayout style="@style/DebugCard">
                <TextView
                    style="@style/DebugCardTitle"
                    android:text="BACKEND ENDPOINT CONFIGURATION" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Switch Ahead between Railway production and your free local Windows PC backend (via Cloudflare Tunnel or local LAN Wi-Fi)." />

                <TextView
                    android:id="@+id/currentServerStatusText"
                    style="@style/DebugSubheading"
                    android:textColor="@color/accent2"
                    android:text="Active Server: ..." />

                <TextView
                    style="@style/DebugLabel"
                    android:text="Custom Server URL" />
                <EditText
                    android:id="@+id/customServerUrlInput"
                    style="@style/DebugInput"
                    android:hint="https://your-tunnel.trycloudflare.com"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/setCustomServerButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Apply URL" />
                    <Button
                        android:id="@+id/resetServerButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Reset Default" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== SECTION 2: CLINICAL DEMO SCENARIOS ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="🩺 CLINICAL DEMO SCENARIOS" />

            <LinearLayout style="@style/DebugCard">
                <TextView
                    style="@style/DebugCardTitle"
                    android:text="ENDOCRINOLOGIST PRESENTATION SUITE" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Select a clinical scenario to demonstrate Ahead's predictive low catches, smart alarm muting, and physiological modeling." />

                <TextView
                    style="@style/DebugSubheading"
                    android:text="SELECT SCENARIO" />
                <FrameLayout style="@style/DebugSpinnerFrame">
                    <Spinner
                        android:id="@+id/scenarioSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <TextView
                    style="@style/DebugLabel"
                    android:text="Playback Speed" />
                <RadioGroup
                    android:id="@+id/speedGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <RadioButton
                        android:id="@+id/speed1x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1x (Real-time)"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent2"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/speed10x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="10x (Accelerated)"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent2" />
                </RadioGroup>

                <!-- Playback controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/playScenarioButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="▶ Play" />
                    <Button
                        android:id="@+id/stepScenarioButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="⏭ Step" />
                    <Button
                        android:id="@+id/stopScenarioButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="⏹ Stop" />
                </LinearLayout>

                <Button
                    android:id="@+id/injectFullDemoButton"
                    style="@style/DebugButton"
                    android:layout_marginTop="8dp"
                    android:text="⚡ Fire Demo Alert (Instant Climax)" />

                <TextView
                    android:id="@+id/scenarioProgressText"
                    style="@style/DebugStatusText"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/debug_input_background"
                    android:padding="10dp"
                    android:text="Ready to demo. Select scenario above." />
            </LinearLayout>

            <!-- ===================== SECTION 3: MANUAL GLUCOSE SIMULATION ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="🧪 GLUCOSE SIMULATION" />

            <LinearLayout style="@style/DebugCard">
                <TextView
                    style="@style/DebugCardTitle"
                    android:text="MANUAL OVERRIDE" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Temporarily injects points into the live chart data pipeline without touching Health Connect." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView style="@style/DebugLabel" android:text="Value (mg/dL)" />
                        <EditText
                            android:id="@+id/manualValueInput"
                            style="@style/DebugInput"
                            android:hint="120"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView style="@style/DebugLabel" android:text="Rate (mg/dL/m)" />
                        <EditText
                            android:id="@+id/manualRateInput"
                            style="@style/DebugInput.Signed"
                            android:hint="-1.5" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/DebugLabel" android:text="Age (min)" />
                        <EditText
                            android:id="@+id/manualAgeInput"
                            style="@style/DebugInput"
                            android:hint="0"
                            android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/injectManualButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Inject Point" />
                    <Button
                        android:id="@+id/forceStaleButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Force Stale" />
                </LinearLayout>

                <Button
                    android:id="@+id/clearInjectionButton"
                    style="@style/DebugButton.Ghost"
                    android:layout_marginTop="8dp"
                    android:text="Clear Injected Data (Restore Health Connect)" />
            </LinearLayout>

            <!-- ===================== SECTION 4: ALERT SOUNDS & NOTIFICATIONS ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="🔊 ALERT TONES &amp; NOTIFICATIONS" />

            <LinearLayout style="@style/DebugCard">
                <TextView
                    style="@style/DebugCardTitle"
                    android:text="ALERT TRIGGERS &amp; PREVIEWS" />

                <!-- Trigger test alert buttons -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="TEST ALERT FIRING" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/forceYellowLowButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="🟡 Yellow Low"
                        android:background="@drawable/number_fill_bg"
                        android:textColor="@color/amber" />
                    <Button
                        android:id="@+id/forceYellowHighButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="🟡 Yellow High"
                        android:background="@drawable/number_fill_bg"
                        android:textColor="@color/amber" />
                    <Button
                        android:id="@+id/forceRedButton"
                        style="@style/DebugButton.Danger"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="🔴 Force Red" />
                </LinearLayout>

                <!-- Tone Auditioning -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="TONE AUDITION (TAP TO HEAR AUDIO)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/playWarnLowButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Warn Low" />
                    <Button
                        android:id="@+id/playCalmLowButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Calm Low" />
                    <Button
                        android:id="@+id/playUrgentLowButton"
                        style="@style/DebugButton.Danger"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:minHeight="38dp"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp"
                        android:text="Urgent Low" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <Button
                        android:id="@+id/playWarnHighButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Warn High" />
                    <Button
                        android:id="@+id/playCalmHighButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Calm High" />
                    <Button
                        android:id="@+id/playUrgentHighButton"
                        style="@style/DebugButton.Danger"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:minHeight="38dp"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp"
                        android:text="Urgent High" />
                </LinearLayout>

                <Button
                    android:id="@+id/playSignalLostButton"
                    style="@style/DebugButton.Ghost"
                    android:layout_marginTop="6dp"
                    android:text="🔊 Tone: Signal Lost" />

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/forceSignalLostButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Force Signal-Lost Alert" />
                    <Button
                        android:id="@+id/cancelAlertsButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Cancel All Alerts" />
                </LinearLayout>

                <!-- Toggles -->
                <LinearLayout style="@style/DebugToggleRow">
                    <TextView style="@style/DebugToggleLabel" android:text="Voice alerts (master audio)" />
                    <Switch
                        android:id="@+id/voiceMasterSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent2"
                        android:trackTint="@color/border" />
                </LinearLayout>

                <LinearLayout style="@style/DebugToggleRow">
                    <TextView style="@style/DebugToggleLabel" android:text="Send app to background when alerting" />
                    <Switch
                        android:id="@+id/autoBackgroundSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent2"
                        android:trackTint="@color/border" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== SECTION 5: DATA PIPELINE & STRESS TESTS ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="📊 DATA PIPELINE &amp; STRESS TESTS" />

            <LinearLayout style="@style/DebugCard">
                <TextView
                    style="@style/DebugCardTitle"
                    android:text="REPORTS, PLATEAUS &amp; BULK DATA" />

                <!-- Doctor Report Gap Test -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="DOCTOR REPORT (14-DAY GAP BENCHMARK)" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Injects a 14-day series with a 6-day sensor outage gap in the middle to verify AGP pagination and gap handling." />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/injectReportTestDataButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Inject 14-day Data" />
                    <Button
                        android:id="@+id/openDoctorReportButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Open Doctor Report" />
                </LinearLayout>

                <!-- Sustained Plateau -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="SUSTAINED HIGH PLATEAU" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Seeds a ~320 mg/dL series across the full plateau lookback window and triggers an immediate check." />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/injectPlateauScenarioButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Inject Plateau" />
                    <Button
                        android:id="@+id/simulateLogCorrectionButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Simulate Correction" />
                </LinearLayout>

                <!-- Backdated Notes Event -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="EVENT NOTES &amp; HISTORY" />
                <FrameLayout style="@style/DebugSpinnerFrame">
                    <Spinner
                        android:id="@+id/debugEventTagSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <EditText
                        android:id="@+id/debugEventNoteInput"
                        style="@style/DebugInput.Text"
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_marginEnd="6dp"
                        android:hint="Test note" />
                    <EditText
                        android:id="@+id/debugEventHoursAgoInput"
                        style="@style/DebugInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="Hours ago"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/injectBackdatedEventButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Inject Note" />
                    <Button
                        android:id="@+id/openNotesHistoryButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Open Notes" />
                </LinearLayout>

                <!-- Random Points -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="RANDOM POINTS VOLUME TEST" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <EditText
                        android:id="@+id/randomCountInput"
                        style="@style/DebugInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:hint="Points (e.g. 150)"
                        android:inputType="number" />
                    <Button
                        android:id="@+id/injectRandomButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Inject Random" />
                </LinearLayout>

                <!-- Full History Export & Graph -->
                <TextView
                    style="@style/DebugSubheading"
                    android:text="ARCHIVE &amp; GRAPH NAVIGATION" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/exportFullHistoryButton"
                        style="@style/DebugButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Export All History" />
                    <Button
                        android:id="@+id/openGraphButton"
                        style="@style/DebugButton.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Open Graph" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== SECTION 6: SAFETY KILLSWITCH & SILENCE ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="🔕 SAFETY, SILENCE &amp; KILLSWITCH" />

            <LinearLayout style="@style/DebugCard.Danger">
                <TextView
                    style="@style/DebugCardTitle.Danger"
                    android:text="EMERGENCY SILENCE &amp; DEV OVERRIDE" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Temporarily suppresses all tones, vibrations, voice alerts, and notifications so you can treat a low in peace." />

                <TextView
                    android:id="@+id/silenceStatusText"
                    style="@style/DebugSubheading"
                    android:textColor="@color/ok"
                    android:text="Status: Alerts Active" />

                <!-- Preset duration chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/silence10mButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="10 min" />
                    <Button
                        android:id="@+id/silence15mButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="15 min" />
                    <Button
                        android:id="@+id/silence30mButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="30 min" />
                    <Button
                        android:id="@+id/silence60mButton"
                        style="@style/DebugButton.Small"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="1 hr" />
                </LinearLayout>

                <Button
                    android:id="@+id/silencePermanentButton"
                    style="@style/DebugButton"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/low"
                    android:text="♾️ Silence Until Cancelled" />

                <Button
                    android:id="@+id/cancelSilenceButton"
                    style="@style/DebugButton.Ghost"
                    android:layout_marginTop="6dp"
                    android:text="Cancel Silence / Re-enable Alerts" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border" />

                <TextView
                    style="@style/DebugSubheading"
                    android:text="DEV KILL SWITCH" />
                <TextView
                    style="@style/DebugLabel"
                    android:text="Total override: blocks EVERYTHING including custom threshold DND overrides. Must be manually turned off." />

                <Button
                    android:id="@+id/devKillSwitchButton"
                    style="@style/DebugButton.Danger"
                    android:layout_marginTop="6dp"
                    android:text="🛑 Enable Dev Kill Switch" />

                <Button
                    android:id="@+id/resetAllTestStateButton"
                    style="@style/DebugButton.Ghost"
                    android:layout_marginTop="8dp"
                    android:text="🔄 Reset Everything to Normal (Live Health Connect)" />
            </LinearLayout>

            <!-- ===================== SECTION 7: SYSTEM DIAGNOSTICS ===================== -->
            <TextView
                style="@style/DebugSectionHeader"
                android:text="📱 SYSTEM DIAGNOSTICS" />

            <LinearLayout style="@style/DebugCard">
                <TextView
                    style="@style/DebugCardTitle"
                    android:text="DEVICE HEALTH &amp; PERMISSIONS" />

                <LinearLayout style="@style/DebugStatusRow">
                    <TextView style="@style/DebugStatusRowLabel" android:text="Battery optimization" />
                    <TextView android:id="@+id/batteryStatusText" style="@style/DebugStatusRowValue" android:text="-" />
                </LinearLayout>
                <LinearLayout style="@style/DebugStatusRow">
                    <TextView style="@style/DebugStatusRowLabel" android:text="Health Connect permissions" />
                    <TextView android:id="@+id/hcPermsStatusText" style="@style/DebugStatusRowValue" android:text="-" />
                </LinearLayout>
                <LinearLayout style="@style/DebugStatusRow">
                    <TextView style="@style/DebugStatusRowLabel" android:text="DND policy access" />
                    <TextView android:id="@+id/dndStatusText" style="@style/DebugStatusRowValue" android:text="-" />
                </LinearLayout>
                <LinearLayout style="@style/DebugStatusRow">
                    <TextView style="@style/DebugStatusRowLabel" android:text="Chart data source" />
                    <TextView android:id="@+id/injectionStatusText" style="@style/DebugStatusRowValue" android:text="-" />
                </LinearLayout>

                <Button
                    android:id="@+id/refreshStatusButton"
                    style="@style/DebugButton.Ghost"
                    android:layout_marginTop="10dp"
                    android:text="Refresh Status" />
            </LinearLayout>

            <!-- ===================== Bottom Actions ===================== -->
            <Button
                android:id="@+id/openTuningButton"
                style="@style/DebugButton"
                android:layout_marginTop="16dp"
                android:text="⚙️ Open Tuning Parameters" />

            <Button
                android:id="@+id/resetWizardButton"
                style="@style/DebugButton.Danger"
