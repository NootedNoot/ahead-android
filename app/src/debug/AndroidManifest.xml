<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only: lets `adb shell am broadcast` inject a fake trend so the
         whole alert chain (repo -> service -> coordinator -> FSI) can be
         exercised without waiting for real hypoglycemia. exported=true is
         required for adb to reach it; the DUMP permission (held only by the
         shell/system UID) keeps other apps out. Merged into debug builds
         only - never ships in release. -->
    <application>
        <activity
            android:name=".debug.TuningActivity"
            android:exported="false" />
        <activity
            android:name=".debug.DebugMenuActivity"
            android:exported="false" />
        <receiver
            android:name=".debug.DebugTrendInjector"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.aheadt1d.app.DEBUG_INJECT_TREND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
