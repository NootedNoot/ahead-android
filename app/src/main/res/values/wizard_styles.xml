<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WizardCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/wizard_card_background</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="WizardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WizardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="WizardStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WizardOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/wizard_option_unselected</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="WizardButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="WizardButtonGhost">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/wizard_option_unselected</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
