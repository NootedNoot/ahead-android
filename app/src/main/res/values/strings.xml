    <string name="voice_footer_note">Voice is separate from the on-screen alerts. Turning a voice off never changes whether an alert shows or sounds — red alerts still take over the screen and pierce Do Not Disturb.</string>

    <!-- Setup wizard: shared -->
    <string name="wizard_title">Set up Ahead</string>
    <string name="wizard_skip_all">Skip setup</string>
    <string name="wizard_skip_step">Skip this step</string>
    <string name="wizard_back">Back</string>
    <string name="wizard_continue">Continue</string>
    <string name="wizard_done_cta">Go to Ahead</string>

    <!-- Step 1: CGM path -->
    <string name="wizard_path_title">Which CGM app do you use?</string>
    <string name="wizard_path_body">Ahead reads your glucose from Health Connect. Tell us which app is putting your readings there.</string>
    <string name="wizard_path_dexcom">Official Dexcom app</string>
    <string name="wizard_path_juggluco">Juggluco</string>
    <string name="wizard_path_unsure">Not sure</string>

    <!-- Step 2: Health Connect install -->
    <string name="wizard_hc_title">Health Connect</string>
    <string name="wizard_hc_body">Health Connect is Android\'s shared health data hub. Ahead reads your glucose through it.</string>
    <string name="wizard_hc_installed">Health Connect is installed.</string>
    <string name="wizard_hc_missing">Health Connect isn\'t installed yet.</string>
    <string name="wizard_hc_install_btn">Install Health Connect</string>

    <!-- Step 3: HC permissions -->
    <string name="wizard_perms_title">Allow Ahead to read glucose</string>
    <string name="wizard_perms_body">Ahead needs permission to read your blood glucose from Health Connect — including in the background, so it can keep checking while your screen is off. It never writes or shares your data.</string>
    <string name="wizard_perms_granted">Glucose read permission granted.</string>
    <string name="wizard_perms_missing">Permission not granted yet.</string>
    <string name="wizard_perms_grant_btn">Grant permission</string>
    <string name="wizard_perms_settings_btn">Open Health Connect settings</string>

    <!-- Step 4: source app sync -->
    <string name="wizard_source_title">Turn on Health Connect sync</string>
    <string name="wizard_source_dexcom">In the Dexcom app, open Settings → Connections → Health Connect and turn on sharing. This toggle is easy to miss, and without it no readings reach Ahead.</string>
    <string name="wizard_source_juggluco">In Juggluco, open the menu → Settings → Health Connect and enable it, then make sure Juggluco is running. Without this, no readings reach Ahead.</string>
    <string name="wizard_source_unsure">If you use Dexcom: Settings → Connections → Health Connect, turn on sharing. If you use Juggluco: menu → Settings → Health Connect, enable it. Turn on whichever one applies.</string>
    <string name="wizard_source_open_dexcom">Open Dexcom</string>
    <string name="wizard_source_open_juggluco">Open Juggluco</string>

    <!-- Step 5: live verification -->
    <string name="wizard_verify_title">First reading</string>
    <string name="wizard_verify_waiting">Waiting for your first reading…</string>
    <string name="wizard_verify_got_it">Got it! Current glucose: %1$d mg/dL</string>
    <string name="wizard_verify_hint">This can take a few minutes after your CGM app syncs. You can skip and check later.</string>

    <!-- Step 6: battery -->
    <string name="wizard_battery_title">Keep Ahead running</string>
    <string name="wizard_battery_body">Android may put Ahead to sleep to save battery, which silently stops glucose checks. Allow it to run unrestricted.</string>
    <string name="wizard_battery_samsung">On Samsung: also open Settings → Apps → Ahead → Battery and choose \"Unrestricted\", and make sure Ahead isn\'t listed under Sleeping or Deep sleeping apps.</string>
    <string name="wizard_battery_granted">Battery optimisation is off for Ahead.</string>
    <string name="wizard_battery_missing">Ahead may be put to sleep in the background.</string>
    <string name="wizard_battery_btn">Allow unrestricted background use</string>

    <!-- Step 7: notifications -->
    <string name="wizard_notif_title">Alerts &amp; notifications</string>
    <string name="wizard_notif_body">Ahead needs a few notification permissions so red alerts can reach you — even on the lock screen and through Do Not Disturb.</string>
    <string name="wizard_notif_post">Show notifications</string>
    <string name="wizard_notif_dnd">Alerts through Do Not Disturb</string>
    <string name="wizard_notif_post_btn">Allow notifications</string>
    <string name="wizard_notif_dnd_btn">Allow Do Not Disturb access</string>
    <string name="wizard_notif_dnd_hint">Find Ahead in the list and turn it on.</string>

    <!-- Step 8: done -->
    <string name="wizard_done_title">You\'re all set</string>
    <string name="wizard_done_body">Ahead is now watching your glucose and will alert you if it trends out of range.</string>
