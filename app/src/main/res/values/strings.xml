    <!-- %1$d is the CURRENT EmergencyContactsPrefs.alertTimeoutMinutes() value,
         not a fixed number - filled in at display time so this can never go
         stale if that setting is changed. -->
    <string name="emergency_sms_rationale">Ahead needs SMS permission to text your emergency contacts. This happens when you confirm a red alert yourself, or automatically if a red alert goes unacknowledged for %1$d minutes.</string>
    <string name="emergency_sms_denied">SMS permission was denied, so no message was sent. You can allow it from Android Settings if you change your mind.</string>
    <string name="emergency_send_failed">Couldn\'t send the emergency SMS. Check your signal and try again.</string>
