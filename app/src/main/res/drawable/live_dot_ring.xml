<?xml version="1.0" encoding="utf-8"?>
<!-- The expanding pulse ring - transparent fill so tinting only recolors the
     stroke. Scale/alpha animated in MainActivity; never shown at all while
     stale. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="@color/ok" />
</shape>
