<?xml version="1.0" encoding="utf-8"?>
<!-- Small pill marking a drawer item as debug-build-only - the item itself
     is visibility="gone" by default and only shown when BuildConfig.DEBUG
     (see MainActivity.setupDrawer), but the badge makes that visually
     obvious too, not just structurally true. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1FF87171" />
    <stroke android:width="1dp" android:color="#80F87171" />
    <corners android:radius="8dp" />
</shape>
