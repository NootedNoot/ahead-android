<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/silenceDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔕 Silence All Alerts"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/silenceDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Suppress all alarm sounds, vibrations, voice alerts, and notifications so you can sleep, focus, or treat a low in peace."
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/silenceDialogStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Status: Alerts Active" />

        <!-- Permanent / Indefinite Silence Option -->
        <Button
            android:id="@+id/btnSilencePermanent"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="0dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_background"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="♾️ Silence Until Cancelled (Permanent)" />

        <!-- Timed Preset Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="TIMED PRESETS"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Row 1: 15m, 30m, 1h -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSilence15"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/time_btn_inactive"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:text="15 min" />

            <Button
                android:id="@+id/btnSilence30"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/time_btn_inactive"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:text="30 min" />

            <Button
                android:id="@+id/btnSilence60"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/time_btn_inactive"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:text="1 hour" />

        </LinearLayout>

        <!-- Row 2: 2h, 4h, Custom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSilence120"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/time_btn_inactive"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:text="2 hours" />

            <Button
                android:id="@+id/btnSilence240"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/time_btn_inactive"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:text="4 hours" />

            <Button
                android:id="@+id/btnSilenceCustom"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/time_btn_inactive"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:text="⏱️ Custom" />

        </LinearLayout>

        <!-- Re-enable alerts / cancel silence -->
        <Button
            android:id="@+id/btnCancelSilence"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_ghost"
            android:textColor="@color/ok"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:text="✓ Re-enable Alerts (Cancel Silence)" />

    </LinearLayout>

</ScrollView>
