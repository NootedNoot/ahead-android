<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated full-screen glucose graph, reached from the home dashboard's
     GLUCOSE TREND card. The chart itself gets essentially the whole screen;
     window/range toggles stay pinned at top so they're reachable without
     scrolling. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/graphBackButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/graph_back"
            app:tint="@color/muted"
            android:padding="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/glucose_trend_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.04"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Own row, not squeezed into the title row above - cramming both text
         buttons in there previously starved the weighted title TextView's
         width down to nothing, which made it wrap vertically letter-by-letter
         instead of showing "GLUCOSE TREND" on one line. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/doctorReportButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/doctor_report_button"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/exportEventsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="Export CSV"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/notesHistoryButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/notes_history_button"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/glucose_trend_label"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.06" />

        <Button
            android:id="@+id/window1hButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:maxLines="1"
            android:text="@string/window_1h"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/window3hButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:maxLines="1"
            android:text="@string/window_3h"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/window6hButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:maxLines="1"
            android:text="@string/window_6h"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/glucose_range_label"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.06" />

        <Button
            android:id="@+id/rangeTightButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:maxLines="1"
            android:text="@string/range_tight"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/rangeFullButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:maxLines="1"
            android:text="@string/range_full"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/rangeAutoButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:maxLines="1"
            android:text="@string/range_auto"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Historical mode: pick an arbitrary past date/range, or page one day at
         a time via a swipe on the chart itself. Hidden entirely while live
         (viewRange == null) except for the "Pick date..." entry point. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dateRangeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/graph_live_label"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/pickDateRangeButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/graph_pick_date_range"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/backToLiveButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/graph_back_to_live"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Colour-ladder legend for the curve's dot colours - same GlucoseSeverity
         palette used everywhere else in the app, not a chart-specific one.
         Horizontally scrollable so it never clips on narrow phones instead of
         silently cutting off a bucket. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/legendContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />

    </HorizontalScrollView>

    <!-- FrameLayout, not the chart directly in the weighted slot: lets the
         tappable event-tag icons float as ordinary Views positioned over the
         chart (translationX/Y computed from the chart's own pixel transform
         each render) and lets the chart's own height be capped to a more
         landscape-oriented aspect ratio at runtime instead of stretching to
         fill all remaining vertical space (which is what made swings look
         artificially steep on tall phones). -->
    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/glucoseChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>
