<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wizard_title"
            android:textColor="@color/ink_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_skip_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/wizard_skip_all"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <!-- Step 0: CGM path -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_path_title" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_path_body" />
                <TextView android:id="@+id/btn_path_dexcom" style="@style/WizardOption" android:text="@string/wizard_path_dexcom" />
                <TextView android:id="@+id/btn_path_juggluco" style="@style/WizardOption" android:text="@string/wizard_path_juggluco" />
                <TextView android:id="@+id/btn_path_unsure" style="@style/WizardOption" android:text="@string/wizard_path_unsure" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 1: HC install -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_hc_title" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_hc_body" />
                <TextView android:id="@+id/tv_hc_status" style="@style/WizardStatus" />
                <Button android:id="@+id/btn_hc_install" style="@style/WizardButton" android:text="@string/wizard_hc_install_btn" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: HC permissions -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_perms_title" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_perms_body" />
                <TextView android:id="@+id/tv_perms_status" style="@style/WizardStatus" />
                <Button android:id="@+id/btn_perms_grant" style="@style/WizardButton" android:text="@string/wizard_perms_grant_btn" />
                <Button android:id="@+id/btn_perms_settings" style="@style/WizardButtonGhost" android:text="@string/wizard_perms_settings_btn" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 3: source sync -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_source_title" />
                <TextView android:id="@+id/tv_source_body" style="@style/WizardBody" />
                <Button android:id="@+id/btn_source_dexcom" style="@style/WizardButtonGhost" android:text="@string/wizard_source_open_dexcom" />
                <Button android:id="@+id/btn_source_juggluco" style="@style/WizardButtonGhost" android:text="@string/wizard_source_open_juggluco" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 4: live verification -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_verify_title" />
                <ProgressBar
                    android:id="@+id/pb_verify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/amber" />
                <TextView android:id="@+id/tv_verify_status" style="@style/WizardStatus" android:text="@string/wizard_verify_waiting" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_verify_hint" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 5: battery -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_battery_title" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_battery_body" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_battery_samsung" />
                <TextView android:id="@+id/tv_battery_status" style="@style/WizardStatus" />
                <Button android:id="@+id/btn_battery" style="@style/WizardButton" android:text="@string/wizard_battery_btn" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 6: notifications -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_notif_title" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_notif_body" />

                <TextView android:id="@+id/tv_notif_post_status" style="@style/WizardStatus" />
                <Button android:id="@+id/btn_notif_post" style="@style/WizardButtonGhost" android:text="@string/wizard_notif_post_btn" />

                <TextView android:id="@+id/tv_notif_dnd_status" style="@style/WizardStatus" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_notif_dnd_hint" />
                <Button android:id="@+id/btn_notif_dnd" style="@style/WizardButtonGhost" android:text="@string/wizard_notif_dnd_btn" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 7: done -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout style="@style/WizardCard">
                <TextView style="@style/WizardTitle" android:text="@string/wizard_done_title" />
                <TextView style="@style/WizardBody" android:text="@string/wizard_done_body" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/wizard_back"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_skip_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/wizard_skip_step"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:paddingHorizontal="28dp"
            android:paddingVertical="10dp"
            android:text="@string/wizard_continue"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
