<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/alertHeadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/red_alert_heading"
        android:textColor="@color/low"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/alertValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:textColor="@color/low"
        android:textSize="110sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alertTrendText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/alertProjectedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textAlignment="center" />

    <!-- Hidden by default; RedAlertActivity shows it only when the feature is
         enabled AND at least one contact is configured. Icon+label sit
         together as one button (drawableStart, not a bare icon glued beside
         text) so it reads as a single deliberate action. -->
    <Button
        android:id="@+id/emergencyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/emergency_button_background"
        android:drawableStart="@drawable/ic_shield"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:paddingHorizontal="20dp"
        android:text="@string/red_alert_send_emergency"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:visibility="gone" />

    <Button
        android:id="@+id/dismissButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_background"
        android:paddingVertical="14dp"
        android:text="@string/red_alert_dismiss"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textAllCaps="false" />

</LinearLayout>
