<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="‹"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Data Upload"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Send your readings somewhere else automatically - for example, so a family member can follow along in Nightscout. Off by default; nothing leaves this phone unless you turn one of these on."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/uploadStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="—"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Method: None -->
        <LinearLayout
            android:id="@+id/methodNoneCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Off"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Don't upload anywhere - the default."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/methodNoneCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/accent2"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Method: Nightscout -->
        <LinearLayout
            android:id="@+id/methodNightscoutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nightscout"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="The most common way to share readings - works with the Nightscout website, xDrip, and most CGM follower apps."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/methodNightscoutCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/accent2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Nightscout fields -->
        <LinearLayout
            android:id="@+id/nightscoutFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SITE URL"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/nightscoutUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="https://your-site.up.railway.app"
                android:inputType="textUri"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/muted"
                android:background="@drawable/input_background"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="ACCESS TOKEN"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="From Nightscout's admin tools - Subject-Access Tokens. Paste the whole token."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/nightscoutTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="token"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/muted"
                android:background="@drawable/input_background"
                android:padding="10dp" />

            <!-- Advanced-only -->
            <LinearLayout
                android:id="@+id/nightscoutAdvancedFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="API SECRET (LEGACY, OPTIONAL)"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Only needed if this Nightscout site doesn't use access tokens. Never sent in plain text."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/nightscoutSecretInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="API secret"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"
                    android:background="@drawable/input_background"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="DEVICE NAME"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="How this shows up as the source in Nightscout. Defaults to Ahead."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/nightscoutDeviceNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Ahead"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"
                    android:background="@drawable/input_background"
                    android:padding="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Method: Webhook -->
        <LinearLayout
            android:id="@+id/methodWebhookCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom webhook"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Advanced: send readings to any URL you control instead. For self-hosted setups, not Nightscout."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/methodWebhookCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/accent2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Webhook fields -->
        <LinearLayout
            android:id="@+id/webhookFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEBHOOK URL"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/webhookUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="https://example.com/ahead-upload"
                android:inputType="textUri"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/muted"
                android:background="@drawable/input_background"
                android:padding="10dp" />

            <!-- Advanced-only -->
            <LinearLayout
                android:id="@+id/webhookAdvancedFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="AUTH HEADER (OPTIONAL)"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="A header name and value your endpoint expects, e.g. Authorization / Bearer abc123."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/webhookHeaderNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Header name (e.g. Authorization)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"
                    android:background="@drawable/input_background"
                    android:padding="10dp" />

                <EditText
                    android:id="@+id/webhookHeaderValueInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Header value"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/muted"
                    android:background="@drawable/input_background"
                    android:padding="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Advanced toggle -->
        <TextView
            android:id="@+id/advancedToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            android:text="Show advanced settings"
            android:textColor="@color/accent2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/testConnectionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_ghost"
                android:text="Test connection"
                android:textAllCaps="false"
                android:textColor="@color/accent2" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
