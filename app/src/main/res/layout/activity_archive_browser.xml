<?xml version="1.0" encoding="utf-8"?>
<!-- Browses GlucoseVaultDatabase's daily summaries and hands a given day's
     DailyArchiveExporter output (JSON + CSV) to the share sheet - the only
     other way to reach this data before this screen existed was manually
     navigating to /Documents/Ahead_Archive/ outside the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/archiveBackButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/graph_back"
            app:tint="@color/muted"
            android:padding="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/archive_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.04"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/archiveSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/archive_subtitle"
        android:textColor="@color/muted"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/archiveEmptyStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="@string/archive_empty_state"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/archiveRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
