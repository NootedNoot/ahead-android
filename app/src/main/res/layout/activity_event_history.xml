<?xml version="1.0" encoding="utf-8"?>
<!-- Full chronological browse of every UserEvent ever logged - the only
     other access points (GraphActivity's chart overlay, the CSV export) are
     either time-windowed or read-only. Edit/delete here is unrestricted by
     age, same as everywhere else (GraphActivity's edit sheet never had an
     age check either - the appearance of a "6-hour lock" was purely that
     GraphActivity only ever fetched events for its 6h chart window). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/historyBackButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/graph_back"
            app:tint="@color/muted"
            android:padding="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/notes_history_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.04"
            android:textStyle="bold" />

        <Button
            android:id="@+id/historySortButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/notes_sort_newest"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/historySearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/time_btn_inactive"
        android:hint="@string/notes_search_hint"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/muted"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/historyTagFilterSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/historyDateRangeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notes_all_dates"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/historyPickDateRangeButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/notes_filter_by_date"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/historyClearDateButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/notes_clear_date_filter"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/historyEmptyStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="@string/notes_empty_state"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
