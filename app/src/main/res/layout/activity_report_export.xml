<?xml version="1.0" encoding="utf-8"?>
<!-- Doctor report export screen: pick a date range, generate both the
     clinical and annotated PDFs from the same underlying data, then hand
     them to a share sheet. Uses the app's normal dark/purple visual identity
     for the screen itself - the PDFs it produces are deliberately a separate,
     print-clean white design (see DoctorReportPdfGenerator). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/reportBackButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/report_back"
            app:tint="@color/muted"
            android:padding="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/doctor_report_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.04"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/doctor_report_intro"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/doctor_report_range_label"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:letterSpacing="0.06" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/preset14dButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/time_btn_active"
            android:paddingVertical="8dp"
            android:text="@string/preset_14d"
            android:textAllCaps="false"
            android:textColor="@color/accent2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/preset30dButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingVertical="8dp"
            android:text="@string/preset_30d"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/preset90dButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/time_btn_inactive"
            android:paddingVertical="8dp"
            android:text="@string/preset_90d"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/customRangeButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/time_btn_inactive"
        android:paddingVertical="8dp"
        android:text="@string/pick_custom_range"
        android:textAllCaps="false"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/selectedRangeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/reportStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/generateInteractiveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_background"
        android:paddingVertical="14dp"
        android:text="@string/generate_interactive_report"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/generateReportButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/time_btn_inactive"
        android:paddingVertical="14dp"
        android:text="@string/generate_report"
        android:textAllCaps="false"
        android:textColor="@color/muted" />

</LinearLayout>
