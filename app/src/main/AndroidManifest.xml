<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ADDED 2026-08-20: guards GlucoseBroadcastReceiver, which can inject an
         unconfirmed fallback glucose reading into the real alert pipeline (see
         that receiver's class doc). protectionLevel="signature" means only an
         app signed with the SAME certificate as this app can hold it - AheadBLE
         V3 (com.ahead.ble) declares uses-permission for this same name, and
         since both are built with the default debug keystore on this owner's
         machine, that's satisfied for now. A release build needs this
         re-verified (matching signing, or a different trust model) before
         shipping - the signature check is what stands between this receiver
         and any other app on the device being able to spoof a glucose value
         into a system that can text an emergency contact. -->
    <permission
        android:name="com.aheadt1d.app.permission.RECEIVE_GLUCOSE_BROADCAST"
        android:protectionLevel="signature" />
    <!-- Defining a custom permission does NOT implicitly grant it to the
         defining app itself - PackageManager still requires an explicit
         uses-permission before this app's own GlucoseBroadcastReceiver is
         actually held to grant it (confirmed live 2026-08-25: every delivery
         attempt from AheadBLE was rejected with "Permission Denial: receiving
         ... requires ... due to sender com.ahead.ble" even though both apps
         share the same debug-keystore signature - the receiver simply never
         held the permission it was supposedly protected by). -->
    <uses-permission android:name="com.aheadt1d.app.permission.RECEIVE_GLUCOSE_BROADCAST" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <!-- Health Connect treats WorkManager's execution context as "background" even
         when triggered from a visible Activity - without this, GlucoseCheckWorker's
         reads throw RemoteException("must be in foreground to read ..."). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Health tab (2026-08-03) - display-only steps/exercise/sleep context,
         read foreground-only (no background permission requested for these,
         unlike glucose above - nothing outside HealthActivity itself needs
         them). See HealthConnectManager.ACTIVITY_PERMISSIONS. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Steps are tracked on-device now (StepTracker, reads the phone's own
         TYPE_STEP_COUNTER sensor directly) instead of through Health Connect
         - Samsung Health wasn't actually syncing steps into HC at all on the
         device this was built against, so that read was silently always
         empty. Required on API 29+ to receive step-counter/detector sensor
         events; harmless no-op permission on older versions. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CriticalLowSiren vibrates directly via the Vibrator service, not
         through a notification channel (see its class doc) - that direct
         call needs its own permission independent of POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required alongside foregroundServiceType="specialUse" on API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- BootReceiver restarts the monitor after a reboot so it survives without
         the user having to reopen the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exact-alarm watchdog (AlarmScheduler): a Doze-piercing heartbeat that
         resurrects the foreground service if an aggressive OEM kills it. USE_EXACT_ALARM
         is auto-granted (no hidden Settings toggle) so the exact path works out of the
         box on API 33+; SCHEDULE_EXACT_ALARM covers API 31-32. If neither is granted,
         AlarmScheduler falls back to an inexact allow-while-idle alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Lets the red channel bypass Do Not Disturb, and the battery-
         optimisation exemption the wizard requests so background checks
         keep running. USE_FULL_SCREEN_INTENT and SEND_SMS were removed
         2026-08-20 along with the full-screen lockout takeover, the
         critical-low siren, and the emergency-contact auto-text feature
         (all gone at the owner's explicit request) - nothing in this app
         uses either anymore. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- healthdata: check Health Connect's install/availability status on API < 34.
         Dexcom/Juggluco: so the setup wizard can auto-detect the installed CGM
         app and offer an "Open <app>" launch button (package visibility, API 30+). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.dexcom.g6" />
        <package android:name="com.dexcom.g7" />
        <package android:name="tk.glucodata" />
    </queries>

    <application
        android:name=".AheadApplication"
        android:label="Ahead"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ahead"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect requires apps requesting health permissions to show a
             rationale when the user views this app's permissions from inside the
             Health Connect app. Points at MainActivity for now. -->
        <activity-alias
            android:name=".HealthConnectPermissionsRationaleAlias"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".setup.SetupWizardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Ahead.Wizard" />

        <activity
            android:name=".voice.VoiceAlertsActivity"
            android:exported="false" />

        <activity
            android:name=".GraphActivity"
            android:exported="false" />

        <activity
            android:name=".events.EventHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".data.ArchiveBrowserActivity"
            android:exported="false" />

        <activity
            android:name=".report.ReportExportActivity"
            android:exported="false" />

        <activity
            android:name=".health.HealthActivity"
            android:exported="false" />

        <activity
            android:name=".upload.UploadSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".account.AccountSettingsActivity"
            android:exported="false" />

        <service
            android:name=".notifications.GlucoseStatusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a persistent notification with the user's current glucose reading and trend" />
        </service>

        <!-- Restarts GlucoseStatusService after a reboot or an app update.
             exported=true because the reboot/replace broadcasts come from the
             system (a different uid); it only ever re-ensures our own service. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Exact-alarm watchdog receiver. exported=false: only our own
             AlarmScheduler PendingIntent ever triggers it. -->
        <receiver
            android:name=".work.WatchdogAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alerts.AlertSnoozeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aheadt1d.app.alerts.ACTION_SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- ADDED 2026-08-20: real-time push from AheadBLE V3 (com.ahead.ble,
             a separate GPLv3 app reading the G7 sensor directly over BLE - see
             the workspace CLAUDE.md). Health Connect stays the durable store;
             this is the instant, redundant path so a Health Connect write
             glitch doesn't silently lose a reading. exported=true because the
             sender is a different app/uid, but permission-gated (signature
             level, see the <permission> declaration above) so only an app
             signed with this app's own certificate can actually deliver it -
             not a random app on the device. See GlucoseBroadcastReceiver's
             class doc for what happens on receipt. -->
        <receiver
            android:name=".bridge.GlucoseBroadcastReceiver"
            android:exported="true"
            android:permission="com.aheadt1d.app.permission.RECEIVE_GLUCOSE_BROADCAST">
            <intent-filter>
                <action android:name="com.ahead.ble.action.GLUCOSE_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- CSV event export: hands a cache file to whatever share target the
             user picks (email, Drive, etc) without exposing the whole cache dir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
